# own prefix
@prefix sn: <https://purl.org/supply-network/onto#> .

# other prefixes
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix voaf: <http://purl.org/vocommons/voaf#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Hierarchies for the dimensions sn:from and sn:into in QB, QB4OLAP, and SNAPO
# - from and into are always on the same level
# - the hierarchy may have several broader levels


# QB category hierarchy (dimension schema)
# - N/A


# QB fact schema

sn:DSD a qb:DataStructureDefinition ;
    qb:component [ qb:dimension sn:from ;
                   qb:componentAttachment qb:Slice ] ;
    qb:component [ qb:dimension sn:into ;
                   qb:componentAttachment qb:Slice ] ;
    qb:sliceKey sn:SK .

sn:SK a qb:SliceKey ;
    qb:dimension sn:from , sn:into .


# QB member hierarchy (dimension instances)
# + one hierarchy for from and into dimensions (distinction?)
# - no distinction between multiple skos:broader statements

sn:from  a qb:DimensionProperty ;
    qb:codeList sn:EntityHierarchy .
sn:into a qb:DimensionProperty ;
    qb:codeList sn:EntityHierarchy .

sn:EntityHierarchy a skos:ConceptScheme .

:tsmc skos:inScheme sn:EntityHierarchy ;
    skos:broader :Taiwan ;
    skos:broader :Foundry .

:Taiwan skos:inScheme sn:EntityHierarchy .

:Foundry skos:inScheme sn:EntityHierarchy .


# QB fact instances

:S a qb:Slice ;
    qb:sliceStructure sn:SK ;
    sn:from :tsmc ;
    sn:into :nvidia ;
    qb:observation :O .

:O a qb:Observation ;
    qb:dataSet :DS .

:DS a qb:DataSet ;
    qb:structure sn:DSD ;
    qb:slice :S .




# QB4OLAP category hierarchy (dimension schema)
# - needs different hierarchy for from and into dimensions
# - needs one property per level

sn:from a qb:DimensionProperty .

sb:supplier a qb4o:LevelProperty ;
    qb4o:inDimension sn:from ;
    qb4o:parentLevel :export , :provider .

:export a qb4o:LevelProperty ;
    qb4o:inDimension sn:from .

:provider a qb4o:LevelProperty ;
    qb4o:inDimension sn:from .

sn:into a qb:DimensionProperty .

sb:customer a qb4o:LevelProperty ;
    qb4o:inDimension sn:into ;
    qb4o:parentLevel :import , :receiver .

:import a qb4o:LevelProperty ;
    qb4o:inDimension sn:into .

:receiver a qb4o:LevelProperty ;
    qb4o:inDimension sn:into .


# QB4OLAP fact schema
# - needs DataStructureDefinition per level and combination
#   of levels if multiple hierarchies in schema (e.g., also time)

sn:DSD_1 a qb:DataStructureDefinition ;
    qb:component [ qb4o:level sb:supplier ;
                   qb:componentAttachment qb:Slice ] ;
    qb:component [ qb4o:level sb:customer ;
                   qb:componentAttachment qb:Slice ] ;
    qb:sliceKey sn:SK_1 .

sn:SK_1 a qb:SliceKey ;
    qb4o:level sb:supplier , sb:customer .

sn:DSD_2 a qb:DataStructureDefinition ;
    qb:component [ qb4o:level :export ;
                   qb:componentAttachment qb:Slice ] ;
    qb:component [ qb4o:level :import ;
                   qb:componentAttachment qb:Slice ] ;
    qb:sliceKey sn:SK_2 .

sn:SK_2 a qb:SliceKey ;
    qb4o:level :export , :import .

sn:DSD_3 a qb:DataStructureDefinition ;
    qb:component [ qb4o:level :provider ;
                   qb:componentAttachment qb:Slice ] ;
    qb:component [ qb4o:level :receiver ;
                   qb:componentAttachment qb:Slice ] ;
    qb:sliceKey sn:SK_3 .

sn:SK_3 a qb:SliceKey ;
    qb4o:level :provider , :receiver .


# QB4OLAP member hierarchy (dimension instances)

:tsmc qb4o:inLevel sb:supplier , sb:customer ;
    skos:broader :Taiwan ;
    skos:broader :Foundry .

:Taiwan qb4o:inLevel :export , :import .

:Foundry qb4o:inLevel :provider , :receiver .


# QB4OLAP fact instances

:S_1 a qb:Slice ;
    qb:sliceStructure sn:SK_1 ;
    sb:supplier :tsmc ;
    sb:customer :nvidia ;
    qb:observation :O_1 .

:O_1 a qb:Observation ;
    qb:dataSet :DS_1 .

:DS_1 a qb:DataSet ;
    qb:structure sn:DSD_1 ;
    qb:slice :S_1 .




# SNAPO category hierarchy (dimension schema)
# - needs one property per relation between levels
# + hierarchy independent of dimension

:registeredInCountry rdfs:subPropertyOf sn:abstractSubstitute ;
    rdfs:domain org:Organization ;
    rdfs:range :Country .

sb:organizationType rdfs:subPropertyOf sn:abstractSubstitute ;
    rdfs:domain org:Organization ;
    rdfs:range :OrganizationType .


# SNAPO fact schema
# + identical to QB

sn:DSD a qb:DataStructureDefinition ;
    qb:component [ qb:dimension sn:from ;
                   qb:componentAttachment qb:Slice ] ;
    qb:component [ qb:dimension sn:into ;
                   qb:componentAttachment qb:Slice ] ;
    qb:sliceKey sn:SK .

sn:SK a qb:SliceKey ;
    qb:dimension sn:from , sn:into .


# SNAPO member hierarchy (dimension instances)
# + natural domain-statements in knowledge graphs (might already exist)
# + compatible to QB

:tsmc a org:Organization ;
    :registeredInCountry :Taiwan ;
    sb:organizationType :Foundry .

:Taiwan a :Country .

:Foundry a :OrganizationType .


# SNAPO fact instances
# + identical to QB

:S a qb:Slice ;
    qb:sliceStructure sn:SK ;
    sn:from :tsmc ;
    sn:into :nvidia ;
    qb:observation :O .

:O a qb:Observation ;
    qb:dataSet :DS .

:DS a qb:DataSet ;
    qb:structure sn:DSD ;
    qb:slice :S .
