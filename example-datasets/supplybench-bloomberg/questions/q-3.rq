PREFIX : <https://purl.org/supply-network/examples/>
PREFIX sn: <https://purl.org/supply-network/onto#>
PREFIX sb: <https://purl.org/supplybench#>
PREFIX geonames: <http://www.geonames.org/ontology#>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX tsmc: <https://solid.iis.fraunhofer.de/oe-40200/2024/10/velektronik-graph-clean/company/weQ20.ttl#>
PREFIX usa: <https://solid.iis.fraunhofer.de/oe-40200/2024/10/velektronik-graph-clean/region/wdQ30.ttl#>

# What are the semiconductor trade volumes from TSMC to US-American enterprises? The query utilises a sum aggregation.

SELECT (SUM(?quantity) AS ?aggregatedQuantity) ?unit ?time
WHERE { ?supplyflow sn:abstraction :EnterpriseAbstraction ;
  	sb:supplier tsmc:this ;
	sb:customer ?customer ;
	sn:volume ?volume .
  ?volume sn:time ?time ;
	sn:quantity ?quantity ;
	sn:unit ?unit .
  ?customer org:hasRegisteredSite/geonames:parentCountry usa:this . }
GROUP BY ?unit ?time
