PREFIX : <https://purl.org/supply-network/examples/>
PREFIX sn: <https://purl.org/supply-network/onto#>
PREFIX sn: <https://purl.org/supply-network/onto#>
PREFIX geonames: <http://www.geonames.org/ontology#>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX nvidia: <https://solid.iis.fraunhofer.de/oe-40200/2024/10/velektronik-graph-clean/company/weQ21.ttl#>
PREFIX taiwan: <https://solid.iis.fraunhofer.de/oe-40200/2024/10/velektronik-graph-clean/region/wdQ865.ttl#>

# What are the semiconductor trade volumes from Taiwanese enterprises to Nvidia? The query utilises a sum aggregation.

SELECT (SUM(?quantity) AS ?aggregatedQuantity) ?unit ?time
WHERE { ?supplyflow sn:abstraction :EnterpriseAbstraction ;
  	sb:supplier ?supplier ;
	sb:customer nvidia:this ;
	sn:volume ?volume .
  ?volume sn:time ?time ;
	sn:quantity ?quantity ;
	sn:unit ?unit .
  ?supplier org:hasRegisteredSite/geonames:parentCountry taiwan:this . }
GROUP BY ?unit ?time
