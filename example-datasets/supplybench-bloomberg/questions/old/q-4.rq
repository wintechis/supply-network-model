PREFIX : <https://purl.org/supply-network/examples/>
PREFIX sn: <https://purl.org/supply-network/onto#>
PREFIX wd: <http://www.wikidata.org/entity/>

# What are the total semiconductor exports from Asia per quarter? The query utilises a prior sum aggregation of the supply flows to the continent abstraction profile and itself aggregates over import continents.

SELECT (SUM(?quantity) AS ?aggregatedQuantity) ?unit ?time
WHERE { ?supplyflow sn:abstraction :ContinentAbstraction ;
  	:continent_export wd:Q48 ;
	:continent_import ?continent ;
	sn:volume ?volume .
  ?volume sn:time ?time ;
	sn:quantity ?quantity ;
	sn:unit ?unit . }
GROUP BY  ?unit ?time
