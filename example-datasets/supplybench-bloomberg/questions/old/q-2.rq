PREFIX : <https://purl.org/supply-network/examples/>
PREFIX sn: <https://purl.org/supply-network/onto#>
PREFIX taiwan: <https://solid.iis.fraunhofer.de/oe-40200/2024/10/velektronik-graph-clean/region/wdQ865.ttl#>
PREFIX usa: <https://solid.iis.fraunhofer.de/oe-40200/2024/10/velektronik-graph-clean/region/wdQ30.ttl#>

# What are the semiconductor trade volumes from Taiwan to the USA? The query utilises a prior sum aggregation of the supply flows to the country abstraction profile.

SELECT ?quantity ?unit ?time
WHERE { ?supplyflow sn:abstraction :CountryAbstraction ;
  	:export taiwan:this ;            
	:import usa:this ;            
	sn:volume ?volume .        
  ?volume sn:time ?time ;            
	sn:quantity ?quantity ;            
	sn:unit ?unit . }
