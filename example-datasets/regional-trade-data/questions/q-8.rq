PREFIX : <https://purl.org/supply-network/examples/>
PREFIX sn: <https://purl.org/supply-network/onto#>
PREFIX tradedata: <http://data.europa.eu/89h/432cf8a7-fd5e-4816-a70c-633a7380c77c#>

# What was the trade volume from Burgenland's agriculture to Wien's food industry in 2010? The query retrieves the volume of the respective supply flow.

SELECT ?quantity ?unit
WHERE { ?flow sn:abstraction :StateIndustryAbstraction ;
        :state_export tradedata:AT11 ;
        :state_import tradedata:AT13 ;
        :supply tradedata:ss1 ;
        :demand tradedata:ss3 ;
        sn:volume ?volume .
    ?volume sn:time tradedata:2010 ;
        sn:quantity ?quantity .}
