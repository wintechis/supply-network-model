PREFIX : <https://purl.org/supply-network/examples/>

# What are the total carbon emmissions in the supply chain of one cubic foot of drinking water?

SELECT (SUM(?emmission) AS ?emmissions)
WHERE { uslci:ddbc73af-51cd-3e7a-8380-2a6b23c05d8f (^:output/:input)* ?component   .
    ?component uslci:emmission ?emmission .}
