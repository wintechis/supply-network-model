# trade data - event/state (proper?)

[] a olca:Process ;
    olca:exchanges [ a olca:Exchange ;
            olca:flow :Money ;
            :owner tradedata:AT11ss1 ;
            olca:isInput true ;
            olca:amount 42.67 ;
            olca:unit cur:MegaUSD ] ,
        [ a olca:Exchange ;
            olca:flow :Money ;
            :owner tradedata:AT13ss3 ;
            olca:isInput false ;
            olca:amount 42.67 ;
            olca:unit cur:MegaUSD ] ;
    :time tradedata:2010 .
tradedata:AT11ss1 a olca:Flow ;
    :part tradedata:AT11 , tradedata:ss1 .
tradedata:AT13ss3 a olca:Flow ;
    :part tradedata:AT13 , tradedata:ss3 .


# trade data - state

tradedata:AT11ss1AT13ss3 a sn:SupplyFlow ;
    sn:abstraction :StateIndustryAbstraction ;
    :state_export tradedata:AT11 ;
    :state_import tradedata:AT13 ;
    :supply tradedata:ss1 ;
    :demand tradedata:ss3 ;
    sn:volume [ a sn:Volume ;
        sn:time tradedata:2010 ;
        sn:quantity 42.67 ;
        sn:unit cur:MegaUSD ] .
tradedata:AT11 a :State ;
    rdfs:label "Burgenland"@en .
tradedata:AT13 a :State ;
    rdfs:label "Wien"@en .
tradedata:ss1 a :Industry ;
    rdfs:label "Agriculture"@en .
tradedata:ss3 a :Industry ;
    rdfs:label "Food_beverages_and_tobacco"@en .


# SupplyBench - event/state (proper?)

[] a olca:Process ;
    olca:exchanges [ a olca:Exchange ;
            olca:flow :Money ;
            :owner tsmc:this ;
            olca:isInput true ;
            olca:amount 479.0 ;
            olca:unit cur:MegaUSD ] ,
        [ a olca:Exchange ;
            olca:flow :Money ;
            :owner nvidia:this ;
            olca:isInput false ;
            olca:amount 479.0 ;
            olca:unit cur:MegaUSD ] ;
    :time <#2020Q3> .
:Money a olca:Flow .


# SupplyBench - event/state (naive)

[] a olca:Process ;
    olca:exchanges [ a olca:Exchange ;
            olca:flow tsmc:this ;
            olca:isInput true ;
            olca:amount 479.0 ;
            olca:unit cur:MegaUSD ] ,
        [ a olca:Exchange ;
            olca:flow nvidia:this ;
            olca:isInput false ;
            olca:amount 479.0 ;
            olca:unit cur:MegaUSD ] .
tsmc:this a olca:Flow ;
    olca:name "TSMC" .
nvidia:this a olca:Flow ;
    olca:name "Nvidia" . 


# SupplyBench - state

nvidia:Q20 a sn:SupplyFlow ;
        sn:abstraction :EnterpriseAbstraction ;
        sb:supplier tsmc:this ;
        sb:customer nvidia:this ;
        sn:volume [ a sn:Volume ;
                sn:time <#2020Q3> ;
                sn:quantity  479.0 ;
                sn:unit cur:MegaUSD ] .
tsmc:this a org:Organization ;
        rdfs:label "TSMC"@en .
nvidia:this a org:Organization ;
        rdfs:label "Nvidia"@en .
