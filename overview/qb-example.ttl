# own prefix
@prefix sn: <https://purl.org/supply-network/onto#> .

# other prefixes
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix voaf: <http://purl.org/vocommons/voaf#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# schema

sn:DSD a qb:DataStructureDefinition ;
    qb:component [ qb:dimension sn:from ;
                   qb:componentAttachment qb:Slice ] ;
    qb:component [ qb:dimension sn:into ;
                   qb:componentAttachment qb:Slice ] ;
    qb:component [ qb:dimension sn:time ;
                   qb:componentAttachment qb:Observation ] ;
    qb:component [ qb:dimension sn:subject ;
                   qb:componentAttachment qb:Observation ] ;
    qb:component [ qb:measure sn:quantity ;
                   qb:componentAttachment qb:Observation ] ;
    qb:component [ qb:attribute sn:unit ;
                   qb:componentRequired "false"^^xsd:boolean ;
                   qb:componentAttachment qb:Observation ] ;
    qb:sliceKey sn:SK .

sn:SK a qb:SliceKey ;
    qb:dimension sn:from , sn:into .

# example dataset

:DS a qb:DataSet ;
    qb:structure sn:DSD ; # inferrable via sn:SupplyNetwork
    qb:slice :S .

:S a qb:Slice ;
    qb:sliceStructure sn:SK ; # inferrable via sn:SupplyFlow
    sn:from :USA ;
    sn:into :Germany ;
    qb:observation :O .

:O a qb:Observation ; # inferrable via sn:Volume
    qb:dataSet :DS ;      
    sn:time :2020 ;
    sn:unit :Euro ;
    sn:quantity 10.0 ;
    sn:subject :Shoes .

# QB violations

# Only attributes may be optional | fix: infer dimension with value sn:all (or sn:allTime, sn:allSubjects) under CWA
# IC-11. All dimensions required | fix: infer dimension with value sn:all under CWA
# IC-12. No duplicate observations | disallows unit transformations, fix: make unit a dimension or allow only one unit per SN
# IC-18. Consistent data set links | disallows inference of flow from qflow

